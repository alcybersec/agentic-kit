{# templates/settings.json.j2 #}
{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash({{ cfg.toolchain.test }}:*)",
      "Bash({{ cfg.toolchain.format }}:*)",
      "Bash({{ cfg.toolchain.lint }}:*)",
      "Bash({{ cfg.toolchain.types }}:*)",
      "Bash({{ cfg.toolchain.pm }}:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      {# `git add <path>` is required, not a convenience: `git commit --only <path>` cannot
         commit a file git is not yet tracking, so without this a role can never commit a
         file it created — and most tasks create one. Found by running the dispatch loop
         on a real repository (M2.1), where the architect produced a contracts document,
         an ADR and 13 passing tests and then could not commit any of them.
         Safe because the four sweep forms are DENIED below and "deny rules from any scope
         are evaluated before allow rules", so this cannot widen them. #}
      "Bash(git add:*)",
      "Bash(git commit --only:*)",
      "Bash(git switch:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)"
{# Read verbs only. `Bash(<cli>:*)` pre-approved `mr create` and `mr merge` too,
   which are outward-facing: visible to other people the moment they run, and not
   undoable from here. pre-bash-guard denies the write verbs and says why; this
   half simply stops pre-approving them, so anything not listed prompts the user.
   The nouns differ per forge, so §6.3's "no rule names a forge" does not hold for
   this block -- it cannot. #}
{% if forge.kind == 'gitlab' %}
      ,"Bash(glab auth status:*)"
      ,"Bash(glab mr list:*)"
      ,"Bash(glab mr view:*)"
      ,"Bash(glab mr diff:*)"
      ,"Bash(glab issue list:*)"
      ,"Bash(glab issue view:*)"
      ,"Bash(glab ci status:*)"
      ,"Bash(glab ci view:*)"
      ,"Bash(glab repo view:*)"
{% elif forge.kind == 'github' %}
      ,"Bash(gh auth status:*)"
      ,"Bash(gh pr list:*)"
      ,"Bash(gh pr view:*)"
      ,"Bash(gh pr diff:*)"
      ,"Bash(gh pr checks:*)"
      ,"Bash(gh issue list:*)"
      ,"Bash(gh issue view:*)"
      ,"Bash(gh run list:*)"
      ,"Bash(gh run view:*)"
      ,"Bash(gh repo view:*)"
{% endif %}
    ],
    "deny": [
{% for s in cfg.secrets %}
      "Read({{ s }})",
      "Edit({{ s }})",
{% endfor %}
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/kit.lock.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git commit --all:*)",
      "Bash(git add --all:*)",
      "Bash(git add -u:*)",
      "Bash(git stash:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)",
      "Bash(git clean:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Agent(orchestrator)"
{% if forge.exclusive and forge.kind == 'gitlab' %}
      ,"Bash(gh:*)"
{% elif forge.exclusive and forge.kind == 'github' %}
      ,"Bash(glab:*)"
{% endif %}
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  }
}
